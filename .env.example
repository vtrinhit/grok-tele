# Lấy tại https://my.telegram.org > API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Tùy chọn
# GROKTELE_BOT=GrokKian_bot
# GROKTELE_PORT=8888
# GROKTELE_API_KEY=          # để trống = không cần key (chỉ nghe 127.0.0.1)
# GROKTELE_DEFAULT_ASPECT=9:16
# GROKTELE_DEFAULT_DURATION=10
# GROKTELE_DEFAULT_RESOLUTION=720p
# GROKTELE_MAX_ATTEMPTS=3
# GROKTELE_VIDEO_TIMEOUT=600     # giây chờ video, quá thì /cancel và thử lại
# GROKTELE_CANCEL_QUIET=20       # sau /cancel, im lặng ngần này giây thì coi như bot đã huỷ render (60 nếu thấy video lọt job)
# GROKTELE_ORPHAN_GRACE=600      # chờ tối đa video về muộn của job bị huỷ trước khi nhận job mới
# GROKTELE_MIN_FREE_MB=1024       # ổ chứa file kết quả còn ít hơn (MB) → job fail ngay với disk_full
# GROKTELE_UI_FAIL_COOLDOWN=30    # lỗi trước khi bot render → tài khoản nghỉ (nhân đôi mỗi lần lỗi liên tiếp)
# GROKTELE_ABANDON_AFTER=300      # job không ai hỏi trạng thái quá ngần này giây → tự huỷ (0 = tắt)
